<header class="preview-nav wrap">
  <a class="wordmark" href="/estudo/" aria-label="Codice, voltar à comparação">codice<span aria-hidden="true">.</span></a>
  <nav aria-label="Navegação principal"><a href="#trabalhos">Trabalhos</a><a href="#pacote">O pacote</a><a class="nav-contact" href={studyOffer.href} target="_blank" rel="noopener noreferrer" aria-label="Conversar no WhatsApp (abre em nova aba)">Vamos conversar <Arrow /></a></nav>
</header>

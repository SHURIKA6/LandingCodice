---
import Study from '../../layouts/Study.astro';
import Nav from '../../components/study/Nav.astro';
import Details from '../../components/study/Details.astro';
import Arrow from '../../components/study/Arrow.astro';
import { studyOffer } from '../../data/study';
import '../../styles/study/fluxo.css';
---
<Study title="Fluxo — nova identidade" theme="fluxo">
  <Nav direction="Fluxo" />
  <main id="conteudo">
    <section class="fluxo-hero wrap"><div class="fluxo-heading"><h1>Seu trabalho<br />merece um<br /><span>lugar próprio.</span></h1><div class="fluxo-symbol" aria-hidden="true"><svg viewBox="0 0 240 240" fill="none"><path d="M120 20v200M20 120h200M49 49l142 142M49 191 191 49" stroke="currentColor" stroke-width="48" /></svg><span>O seu próximo<br />ponto de contato.</span></div></div><div class="fluxo-offer"><p class="hero-description">{studyOffer.headline}</p><div class="fluxo-action"><p class="offer-line"><span>Site de uma página</span><strong>{studyOffer.price}</strong></p><a class="cta" href={studyOffer.href} target="_blank" rel="noopener noreferrer">{studyOffer.cta}<Arrow /><span class="sr-only"> (abre em nova aba)</span></a></div></div></section>
    <section class="fluxo-lab" aria-labelledby="fluxo-lab-title"><div class="wrap"><div class="lab-heading"><h2 id="fluxo-lab-title">Tudo o que importa.<br />Um lugar para encontrar.</h2><div class="lab-tabs" role="group" aria-label="Colocar em evidência"><button data-fluxo-tab="services" aria-pressed="true" disabled>Serviços</button><button data-fluxo-tab="work" aria-pressed="false" disabled>Trabalhos</button><button data-fluxo-tab="contact" aria-pressed="false" disabled>Contato</button></div></div>
      <div class="fluxo-canvas" data-fluxo-canvas data-focus="services"><div class="demo-nav"><strong>Seu negócio.</strong><span>Um espaço que apresenta você.</span><span class="demo-nav-dot" aria-hidden="true"></span></div><div class="demo-grid"><div class="demo-title"><span>Seu trabalho faz a diferença.</span><strong>Mostre isso<br />ao mundo.</strong></div><div class="demo-services"><span>O que você faz</span><strong>Seu serviço,<br />bem explicado.</strong><div class="demo-rule"></div><p>Informações que ajudam<br />o cliente a escolher.</p><Arrow /></div><div class="demo-work"><span>O que você já fez</span><div class="work-shapes" aria-hidden="true"><i></i><i></i><i></i></div><strong>Trabalhos para<br />conhecer de perto.</strong></div><div class="demo-contact"><span>Uma conversa começa aqui.</span><strong>Falar com a empresa <Arrow /></strong></div></div></div>
      <div class="lab-caption"><p data-fluxo-status aria-live="polite">Serviços em evidência: explique o que você faz e para quem.</p><span>Composição ilustrativa</span></div>
    </div></section>
    <Details />
  </main>
  <script>
    import { setupFluxo } from '../../scripts/study';
    setupFluxo();
  </script>
</Study>

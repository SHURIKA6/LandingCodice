---
import '../styles/global.css';
import { landing } from '../data/landing';
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const organization = {
  '@context': 'https://schema.org', '@type': 'Organization', name: 'Codice', description: landing.description,
  ...(Astro.site ? { url: Astro.site.href } : {}),
  foundingLocation: { '@type': 'City', name: 'Sinop, Mato Grosso, Brasil' },
  founder: landing.founders.map(person => ({ '@type': 'Person', name: person.name, sameAs: person.githubHref })),
};
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={landing.description} />
    <meta name="theme-color" content="#151419" />
    <link rel="icon" type="image/svg+xml" href="/brand.svg" />
    <link rel="preload" href="/fonts/study/archivo-black-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/study/manrope-latin.woff2" as="font" type="font/woff2" crossorigin />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Codice" />
    <meta property="og:title" content={landing.title} />
    <meta property="og:description" content={landing.description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={landing.title} />
    <meta name="twitter:description" content={landing.description} />
    <title>{landing.title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(organization).replace(/</g, '\\u003c')} />
  </head>
  <body><a class="skip-link" href="#conteudo">Ir para o conteúdo</a><slot /></body>
</html>

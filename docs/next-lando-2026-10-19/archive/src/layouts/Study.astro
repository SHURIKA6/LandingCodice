---
import '../styles/study/base.css';
interface Props { title: string; theme?: string; }
const { title, theme = 'panel' } = Astro.props;
---
<!doctype html>
<html lang="pt-BR" data-theme={theme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content={theme === 'ritmo' ? 'dark' : 'light'} />
    <meta name="theme-color" content={theme === 'ritmo' ? '#151419' : theme === 'fluxo' ? '#f3f0e7' : '#dce4ee'} />
    <meta name="description" content="Estudo comparativo da nova identidade da Codice. Três direções visuais e suas prévias interativas." />
    <link rel="icon" href="/study/mark.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/study/manrope-latin.woff2" as="font" type="font/woff2" crossorigin />
    {theme === 'fluxo' && <link rel="preload" href="/fonts/study/bricolage-grotesque-latin.woff2" as="font" type="font/woff2" crossorigin />}
    {theme === 'ritmo' && <link rel="preload" href="/fonts/study/archivo-black-latin.woff2" as="font" type="font/woff2" crossorigin />}
    <title>{title} — Codice</title>
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Ir para o conteúdo</a>
    <slot />
  </body>
</html>

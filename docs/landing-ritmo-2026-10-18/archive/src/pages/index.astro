---
import Page from '../layouts/Page.astro';
import Arrow from '../components/Arrow.astro';
import { siteContent as content } from '../data/site';
const year = new Date().getFullYear();
---
<Page>
  <div class="book-cover" id="inicio">
    <header class="site-header hero-width">
      <a class="wordmark" href="#inicio" aria-label="Codice — início">Codice</a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="navegacao">Menu <span aria-hidden="true" class="menu-lines"></span></button>
      <nav id="navegacao" class="main-nav" aria-label="Navegação principal">{content.navigation.map((item) => <a href={item.href}>{item.label}</a>)}</nav>
    </header>
    <section class="hero-copy hero-width" aria-labelledby="page-title">
      <h1 id="page-title">{content.headlineLines.map((line, index) => <span>{line.text}{'emphasis' in line && <em>{line.emphasis}</em>}{index < content.headlineLines.length - 1 && ' '}</span>)}</h1>
      <p class="hero-intro">{content.introLines.map((line, index) => <span>{line}{index < content.introLines.length - 1 && ' '}</span>)}</p>
      <a class="paper-button" href={content.primaryContactHref} target="_blank" rel="noopener noreferrer">{content.primaryContactLabel}<Arrow /><span class="sr-only"> pelo WhatsApp de Fernando (abre em outra aba)</span></a>
    </section>
  </div>
  <main id="conteudo" class="book-pages" tabindex="-1">
    <section id="trabalhos" class="work-section page-width" aria-labelledby="work-title">
      <div class="section-heading"><h2 id="work-title">Trabalhos que <em>já saíram do papel</em></h2><span aria-hidden="true" class="heading-rule"></span></div>
      <div class="projects">{content.projects.map((project, index) => (
        <article class:list={['project', { 'project--reverse': index === 1 }]} aria-labelledby={`${project.id}-title`}>
          <a class="project-visual" href={project.href} target="_blank" rel="noopener noreferrer" aria-label={`${project.linkLabel}: ${project.title} (abre em outra aba)`}><img src={project.image.src} alt={project.image.alt} width="1440" height="900" loading={index === 0 ? 'eager' : 'lazy'} decoding="async" /></a>
          <div class="project-info"><h3 id={`${project.id}-title`}><a href={project.href} target="_blank" rel="noopener noreferrer">{project.title}<span class="sr-only"> — {project.linkLabel} (abre em outra aba)</span></a></h3><p class="project-category">{project.category}</p><div class="project-inline-details"><p>{project.description}</p><a class="text-link" href={project.href} target="_blank" rel="noopener noreferrer">{project.linkLabel}<Arrow /><span class="sr-only"> (abre em outra aba)</span></a></div></div>
        </article>
      ))}</div>
      <div class="project-notes">{content.projects.map((project) => <div><h3>{project.title}</h3><p>{project.description}</p><a class="text-link" href={project.href} target="_blank" rel="noopener noreferrer">{project.linkLabel}<Arrow /><span class="sr-only"> (abre em outra aba)</span></a></div>)}</div>
    </section>
    <section id="servicos" class="services-section page-width ruled-section" aria-labelledby="services-title">
      <h2 id="services-title">Tecnologia para o que <em>você precisa fazer.</em></h2>
      <div class="service-list">{content.services.map((service) => <article class="service"><h3>{service.title}</h3><div><p>{service.description}</p><ul>{service.features.map((feature) => <li>{feature}</li>)}</ul></div></article>)}</div>
      <aside class="support-note" aria-labelledby="support-title"><div><h3 id="support-title">{content.support.title}</h3><p>{content.support.description}</p><p class="support-area">{content.support.area}</p></div><a class="text-link" href={content.support.href} target="_blank" rel="noopener noreferrer">{content.support.contactLabel}<Arrow /><span class="sr-only"> pelo WhatsApp (abre em outra aba)</span></a></aside>
    </section>
    <section id="a-dupla" class="founders-section page-width ruled-section" aria-labelledby="founders-title">
      <div class="about-intro"><h2 id="founders-title">Você conversa com <em>quem desenvolve.</em></h2><p>{content.about.description}</p></div>
      <div class="founders">{content.founders.map((founder) => <article class="founder"><h3>{founder.name}</h3><p>Co-fundador da Codice</p><div class="founder-links"><a class="text-link" href={founder.githubHref} target="_blank" rel="noopener noreferrer">Conhecer no GitHub<Arrow /><span class="sr-only"> (abre em outra aba)</span></a><a class="text-link" href={founder.whatsappHref} target="_blank" rel="noopener noreferrer">Falar com {founder.name.split(' ')[0]}<Arrow /><span class="sr-only"> pelo WhatsApp (abre em outra aba)</span></a></div></article>)}</div>
    </section>
  </main>
  <footer class="contact-cover" id="contato"><div class="page-width">
    <div class="contact-intro"><h2>Vamos abrir o <em>próximo capítulo?</em></h2><p>{content.contact.description}</p></div>
    <div class="contact-people">{content.founders.map((founder) => <a class="contact-person" href={founder.whatsappHref} target="_blank" rel="noopener noreferrer"><span>Conversar com {founder.name.split(' ')[0]}</span><span class="contact-number">{founder.phoneLabel}</span><Arrow /><span class="sr-only"> pelo WhatsApp (abre em outra aba)</span></a>)}</div>
    <div class="colophon"><a class="footer-wordmark" href="#inicio" aria-label="Codice — voltar ao início">Codice</a><p>Sinop, Mato Grosso · Projetos em todo o Brasil.</p><small>© {year} Codice</small></div>
  </div></footer>
</Page>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.querySelector<HTMLElement>('#navegacao');
  const closeMenu = () => { toggle?.setAttribute('aria-expanded', 'false'); nav?.classList.remove('is-open'); };
  toggle?.addEventListener('click', () => { const opening = toggle.getAttribute('aria-expanded') !== 'true'; toggle.setAttribute('aria-expanded', String(opening)); nav?.classList.toggle('is-open', opening); });
  nav?.addEventListener('click', (event) => { if ((event.target as HTMLElement).closest('a')) closeMenu(); });
  document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') { closeMenu(); toggle.focus(); } });
  document.addEventListener('click', (event) => { if (event.target instanceof Node && !nav?.contains(event.target) && !toggle?.contains(event.target)) closeMenu(); });
  window.matchMedia('(min-width: 701px)').addEventListener('change', closeMenu);
</script>
